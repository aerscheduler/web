# API origin the console talks to.
# In production (Vercel), set:
#   VITE_API_URL=https://api.aerscheduler.com
VITE_API_URL=

# Local dev: committed in .env.development (127.0.0.1:5001). Override here if needed.
# Post-deploy smoke only:
# VITE_API_PROXY=https://api.aerscheduler.com

# Optional: the public site the command palette reads help documentation from.
# Defaults to https://www.aerscheduler.com. Point it at a local `website` dev
# server (e.g. http://localhost:3000) to search unpublished articles.
# VITE_SITE_URL=
