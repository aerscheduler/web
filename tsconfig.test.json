{
  /**
   * Unit tests, type-checked separately from the app they test.
   *
   * A test may read a captured API payload off disk, so it needs Node's types. The app
   * project deliberately does NOT have them: `types: ["vite/client"]` there is what stops
   * `node:fs` type-checking inside code that ships to a browser, and widening it to unblock
   * one test would remove that guard from every file.
   *
   * Splitting them keeps both: `tsc -b` still checks the tests, with the globals a test
   * actually runs under.
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["node", "vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "paths": { "@/*": ["./src/*"] },

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "vitest.config.ts"]
}
